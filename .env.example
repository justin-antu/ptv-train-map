# Copy this file to `.env` and fill in your real values for local testing.
# In GitHub Actions these are repository secrets of the same names.
#
# Everything except VITE_CARTO_BASEMAP_KEY is used ONLY by the Node scripts in
# scripts/, which run server-side (locally, or in the "refresh-data" and
# "refresh-timetable" workflows). They are never bundled into the browser app.

# Victorian GTFS-Realtime feeds — the primary live data source. Register at
# https://opendata.transport.vic.gov.au and subscribe to the GTFS-Realtime
# product. Note the API expects this in a `KeyID` header, not the
# `Ocp-Apim-Subscription-Key` header the published OpenAPI document advertises.
VIC_GTFS_R_KEY=

# PTV Timetable API v3 credentials, now used only for service disruptions and
# for verifying route metadata when regenerating the timetable. Register at
# https://www.vic.gov.au/public-transport-timetable-api
PTV_DEV_ID=
PTV_API_KEY=

# CARTO basemap key. Unlike the above this IS bundled into the client (hence the
# VITE_ prefix); without it the deployed map tiles carry a watermark.
VITE_CARTO_BASEMAP_KEY=
