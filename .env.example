# PTV Timetable API v3 credentials.
# Get your own devId + API key by registering at:
# https://www.vic.gov.au/public-transport-timetable-api
#
# These are ONLY used by the Node scripts in scripts/ (e.g. scripts/fetch-live-data.ts),
# which run server-side (locally, or in the GitHub Actions "refresh-data" workflow).
# They are never bundled into or exposed by the browser app.
#
# Copy this file to `.env` and fill in your real values for local testing.
# In GitHub Actions, set these as repository secrets named PTV_DEV_ID and PTV_API_KEY instead.

PTV_DEV_ID=
PTV_API_KEY=
VITE_CARTO_BASEMAP_KEY=
